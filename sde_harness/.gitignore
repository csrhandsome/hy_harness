__pycache__/
*.py[cod]
*.egg-info/

# Local secrets / machine-specific env (CURSOR_API_KEY, etc.).
.env.local

# CodeBuddy project settings (harness may write models.json for OpenAI endpoints).
.codebuddy/

# Local run outputs.
logs/

/resources/*
!/resources/robotwin/
/resources/robotwin/*
!/resources/robotwin/memory/
/resources/robotwin/memory/*
!/resources/robotwin/memory/MEMORY.md
!/resources/robotwin/memory/control_and_chunk_semantics.md
!/resources/robotwin/memory/bimanual_ee_conventions.md
!/resources/robotwin/memory/failure_and_audit_protocol.md
!/resources/robotwin/references/
/resources/robotwin/references/*
!/resources/robotwin/references/README.md

# Prefer the repo-root .venv (uv workspace). Ignore a leftover local venv.
.venv/
# Lockfile lives at repo root; do not keep a nested one.
uv.lock

build/
.claude/settings.json
