# Copy to .env.local and fill in (`.env.local` is gitignored).
# Mint at: https://cursor.com/dashboard/api
CURSOR_API_KEY=crsr_xxxxxxxx
# Fast path (default): composer-2.5 + fast=true. Avoid bare `auto` if latency matters.
# CURSOR_MODEL=composer-2.5
# CURSOR_MODEL_PARAMS=fast=true
# CURSOR_TIMEOUT_S=1200

# CodeBuddy Agent SDK (https://www.codebuddy.ai/docs/cli/sdk)
# International: https://www.codebuddy.ai/profile/keys
# China: https://copilot.tencent.com/profile/  (+ CODEBUDDY_INTERNET_ENVIRONMENT=internal)
# CODEBUDDY_API_KEY=xxxxxxxx
# CODEBUDDY_MODEL=deepseek-v3.1
# CODEBUDDY_TIMEOUT_S=1200
# CODEBUDDY_INTERNET_ENVIRONMENT=internal
#
# Local OpenAI-compatible serving (e.g. serving/ vLLM hy-embodied-vlm-1.0):
#   bash serving/scripts/serve.sh --model hy-embodied-vlm-1.0
# CODEBUDDY_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# CODEBUDDY_API_KEY=EMPTY
# CODEBUDDY_MODEL=hy_a3b
# CODEBUDDY_BASE_URL=https://...   # Anthropic-protocol third-party (optional)
